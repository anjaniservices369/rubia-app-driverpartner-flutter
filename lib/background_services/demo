@pragma('vm:entry-point')
void onStart(ServiceInstance service) async {
  DartPluginRegistrant.ensureInitialized();

  if (service is AndroidServiceInstance) {
    service.setAutoStartOnBootMode(true);

    service.on('setAsForeground').listen((event) async {
      await service.setAsForegroundService();
    });

    service.on('setAsBackground').listen((event) async {
      await service.setAsBackgroundService();
    });

    service.on('setAutoStartOnBootMode').listen((event) async {
      print("^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^6");
    });
  }

  service.on("stop_service").listen((event) async {
    await service.stopSelf();
  });

  var usageHours = await BackgroundService.getUsageHours();
  int adjustedTimeInterval = usageHours == 1 ? 45 : 180;
  int timeInterval = adjustedTimeInterval;

  List _locationData = [];

  Timer? locationUpdateTimer;

  void startLocationUpdates() {
    locationUpdateTimer = Timer.periodic(Duration(seconds: timeInterval), (timer) async {
      if (service is AndroidServiceInstance) {
        if (await service.isForegroundService()) {
          var path = await getApplicationDocumentsDirectory();
          Hive.init(path.path);
          await Hive.openBox('peopleBox');
          final box = Hive.box('peopleBox');

          StreamSubscription<Position>? positionStream;

          positionStream = Geolocator.getPositionStream(
            locationSettings: LocationSettings(
              accuracy: LocationAccuracy.bestForNavigation,
            ),
          ).listen((Position position) async {
            final permission = await Geolocator.checkPermission();
            if (permission == LocationPermission.always) {
              service.invoke('on_location_changed', position.toJson());
              _locationData.add("${position.latitude},${position.longitude}");
              if (box.isOpen) {
                box.put(
                  position.timestamp.toString(),
                  "${position.latitude},${position.longitude}",
                );
              } else {
                var path = await getApplicationDocumentsDirectory();
                Hive.init(path.path);
                await Hive.openBox('peopleBox');
                final box = Hive.box('peopleBox');
                box.put(
                  position.timestamp.toString(),
                  "${position.latitude},${position.longitude}",
                );
              }
            }
          });

          // Stop the position stream when the timer is canceled or when service is stopped
          locationUpdateTimer?.onCancel = () {
            positionStream?.cancel();
          };
        }
      }
    });
  }

  void stopLocationUpdates() {
    locationUpdateTimer?.cancel();
  }

  // Start location updates when the service starts
  startLocationUpdates();

  // ... (rest of your code)
}
